<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dockControls="using:Dock.Avalonia.Controls"
             xmlns:local="using:OasisEditor.Avalonia"
             x:Class="OasisEditor.Avalonia.EditorApplication"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <local:WorkspacePaneHeaderTemplate x:Key="WorkspacePaneHeader" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WorkspaceBrush">#282828</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBrush">#383838</SolidColorBrush>
          <SolidColorBrush x:Key="ToolbarBrush">#303030</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#D6D6D6</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#A0A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#202020</SolidColorBrush>
          <Color x:Key="ViewportBackground">#242424</Color>
          <Color x:Key="ViewportGrid">#303030</Color>
          <Color x:Key="ElementFallback">#575F68</Color>
          <Color x:Key="ElementOutline">#9199A2</Color>
          <Color x:Key="SelectionColor">#59A8EB</Color>
          <Color x:Key="SceneColliderColor">#6645A8F0</Color>
          <Color x:Key="SceneTriggerColor">#66EF75B4</Color>
          <Color x:Key="ReelSurfaceColor">#FFCCD1D8</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WorkspaceBrush">#CBCBCB</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBrush">#E5E5E5</SolidColorBrush>
          <SolidColorBrush x:Key="ToolbarBrush">#D8D8D8</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#242424</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#626262</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#B0B0B0</SolidColorBrush>
          <Color x:Key="ViewportBackground">#BDBDBD</Color>
          <Color x:Key="ViewportGrid">#B2B2B2</Color>
          <Color x:Key="ElementFallback">#9CA9B8</Color>
          <Color x:Key="ElementOutline">#485868</Color>
          <Color x:Key="SelectionColor">#146EAF</Color>
          <Color x:Key="SceneColliderColor">#662A76B8</Color>
          <Color x:Key="SceneTriggerColor">#66AC2870</Color>
          <Color x:Key="ReelSurfaceColor">#FF939BA5</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <dock:DockFluentTheme />
    <Style Selector="dockControls|ToolChromeControl">
      <Setter Property="local:ToolChromeIcons.ShowIcon" Value="True" />
    </Style>
    <Style Selector="dockControls|ToolTabStrip">
      <Setter Property="HeaderTemplate" Value="{StaticResource WorkspacePaneHeader}" />
    </Style>
    <!-- Inherit the same semantic foreground as the adjacent label, including
         selected tabs/rows. MutedBrush supplies the disabled theme colour. -->
    <Style Selector="local|EditorIcon:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Dock repeats a tool group's minimum on its nested chrome and content.
         Keep the minimum on ToolDockControl only, so the title and bottom tabs
         fit inside that allocation rather than pushing the tabs underneath status. -->
    <Style Selector="dockControls|ToolChromeControl, dockControls|ToolControl">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource WorkspaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Dock supplies the vector close glyph and command. Keep compact tab buttons
         clear of the general authoring-button padding above. -->
    <Style Selector="dockControls|DocumentTabStripItem Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="(AutomationProperties.Name)" Value="Close document" />
      <Setter Property="ToolTip.Tip" Value="Close document" />
    </Style>
    <Style Selector="dockControls|DocumentTabStripItem Path#PART_ClosePath">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <!-- Tool chrome uses the same compact Dock glyph buttons. General button
         padding otherwise consumes their content area and hides the vectors. -->
    <Style Selector="dockControls|ToolChromeControl /template/ Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="25" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
