<Window x:Class="OasisEditor.FaceGenerationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Face Generation Settings" Height="520" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource EditorBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Tune perspective artwork, lamp mask, and auto-authored tray generation."/>

            <TextBlock FontWeight="SemiBold" Text="Perspective Artwork"/>
            <Separator Margin="0,3,0,5"/>
            <CheckBox Margin="0,2,0,5" Foreground="{DynamicResource TextPrimaryBrush}" Content="Post-warp sharpening"
                      IsChecked="{Binding PostWarpSharpeningEnabled}"/>
            <Grid IsEnabled="{Binding PostWarpSharpeningEnabled}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Sharpen amount" ToolTip="Strength of detail restoration after perspective resampling."/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding PostWarpSharpeningAmountText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Strength of detail restoration after perspective resampling."/>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Radius (pixels)" ToolTip="Size of image detail affected by sharpening, in pixels."/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding PostWarpSharpeningRadiusPixelsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Size of image detail affected by sharpening, in pixels."/>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Threshold" ToolTip="Minimum local difference before sharpening is applied. Higher values reduce sharpening of subtle texture or noise."/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding PostWarpSharpeningThresholdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum local difference before sharpening is applied. Higher values reduce sharpening of subtle texture or noise."/>
            </Grid>

            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Lamp Mask Generation"/>
            <Separator Margin="0,3,0,5"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Mask threshold"/>
                <TextBox Grid.Column="1" Margin="0,2" Text="{Binding MaskExtractionThresholdText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Lamp Tray Generation"/>
            <Separator Margin="0,3,0,5"/>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Tray inflation percent"/><TextBox Grid.Column="1" Margin="0,2" Text="{Binding TrayBoundsInflationPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Tray padding pixels"/><TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding TrayBoundsPaddingPixelsText, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Content="Clamp tray bounds to lamp window" IsChecked="{Binding ClampTrayBoundsToLampWindow}"/>
            </Grid>
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#FFFF6B6B" TextWrapping="Wrap" Text="{Binding ErrorMessage}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/><Button x:Name="ActionButton" Width="110" IsDefault="True" Click="OnActionClicked"/>
        </StackPanel>
    </Grid>
</Window>
