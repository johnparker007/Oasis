<UserControl x:Class="OasisEditor.Views.EpochFabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel><TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Maygay Epoch / Fabric"/><TabControl Margin="0,8,0,0">
  <TabItem Header="ROMs"><ScrollViewer><StackPanel Margin="8"><TextBlock Text="Program ROMs" FontWeight="SemiBold"/><TextBox Text="{Binding EpochProjectSettings.ProgramRom1Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.ProgramRom2Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.ProgramRom3Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.ProgramRom4Path, UpdateSourceTrigger=LostFocus}"/><TextBlock Margin="0,8,0,0" Text="Sound ROMs" FontWeight="SemiBold"/><TextBox Text="{Binding EpochProjectSettings.SoundRom1Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.SoundRom2Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.SoundRom3Path, UpdateSourceTrigger=LostFocus}"/><TextBox Text="{Binding EpochProjectSettings.SoundRom4Path, UpdateSourceTrigger=LostFocus}"/><CheckBox Margin="0,8" Content="Flash ROM Mode" IsChecked="{Binding EpochProjectSettings.FlashRomMode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Reels"><StackPanel Margin="8"><CheckBox Content="Configure Reels" IsChecked="{Binding EpochProjectSettings.ConfigureReels}"/><DataGrid ItemsSource="{Binding EpochProjectSettings.Reels}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply}"/><DataGridTextColumn Header="Reel" Binding="{Binding ReelIndex}"/><DataGridTextColumn Header="Steps" Binding="{Binding Steps}"/><DataGridTextColumn Header="Opto Start" Binding="{Binding OptoStart}"/><DataGridTextColumn Header="Opto End" Binding="{Binding OptoEnd}"/><DataGridCheckBoxColumn Header="Opto Invert" Binding="{Binding OptoInvert}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><CheckBox Content="Apply Reel Extension" IsChecked="{Binding EpochProjectSettings.ApplyReelExt}"/><TextBox Margin="8,0" Width="100" Text="{Binding EpochProjectSettings.ReelExt}"/></StackPanel></StackPanel></TabItem>
  <TabItem Header="Coins"><StackPanel Margin="8"><CheckBox Content="Configure Coins" IsChecked="{Binding EpochProjectSettings.ConfigureCoins}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Communication Style"/><ComboBox Margin="8,0" Width="120" ItemsSource="{Binding EpochCoinCommunicationStyles}" SelectedItem="{Binding EpochProjectSettings.CommunicationStyle}"/><CheckBox Content="Invert" IsChecked="{Binding EpochProjectSettings.CommunicationInvert}"/><TextBlock Margin="8,0" Text="Pulse Cycles"/><TextBox Width="100" Text="{Binding EpochProjectSettings.PulseCycles}"/><CheckBox Content="EDC Enabled" IsChecked="{Binding EpochProjectSettings.EdcEnabled}"/></StackPanel><DataGrid ItemsSource="{Binding EpochProjectSettings.Coins}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply}"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Value" Binding="{Binding Value}"/><DataGridTextColumn Header="Lockout Value" Binding="{Binding LockoutValue}"/><DataGridCheckBoxColumn Header="Lockout Invert" Binding="{Binding LockoutInvert}"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
  <TabItem Header="Machine Options"><StackPanel Margin="8"><CheckBox Content="Configure Machine Options" IsChecked="{Binding EpochProjectSettings.ConfigureMachineOptions}"/><CheckBox Content="Apply DIP switches" IsChecked="{Binding EpochProjectSettings.ApplyDips}"/><TextBox Text="{Binding EpochProjectSettings.DipSwitchBits}"/><CheckBox Content="Apply Stake" IsChecked="{Binding EpochProjectSettings.ApplyStake}"/><TextBox Text="{Binding EpochProjectSettings.Stake}"/><CheckBox Content="Apply Prize" IsChecked="{Binding EpochProjectSettings.ApplyPrize}"/><TextBox Text="{Binding EpochProjectSettings.Prize}"/><CheckBox Content="Apply Percentage" IsChecked="{Binding EpochProjectSettings.ApplyPercentage}"/><TextBox Text="{Binding EpochProjectSettings.Percentage}"/></StackPanel></TabItem>
 </TabControl></DockPanel>
</UserControl>
