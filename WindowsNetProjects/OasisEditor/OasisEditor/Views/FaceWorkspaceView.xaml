<UserControl x:Class="OasisEditor.Views.FaceWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OasisEditor" xmlns:views="clr-namespace:OasisEditor.Views" PreviewKeyDown="OnPreviewKeyDown">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Summary" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource PanelBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Padding="12,9" Background="{DynamicResource ToolBarBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Margin="4,0" Padding="10,4" Content="Overview" Command="{Binding FaceWorkspace.NavigateToOverviewCommand}"/><Button Margin="4,0" Padding="10,4" Content="Face Editor" Command="{Binding FaceWorkspace.NavigateToFaceEditorCommand}"/></StackPanel>
    <ItemsControl ItemsSource="{Binding FaceWorkspace.Breadcrumbs}">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Orientation="Horizontal">
        <TextBlock Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="›">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Visible"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
             <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <Button Padding="2" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}" Content="{Binding Label}" Command="{Binding Command}"/>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Overview}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Artwork}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Components}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Illumination}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
    <Grid><StackPanel MaxWidth="980">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Overview}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Style="{StaticResource Heading}" FontSize="24" Text="Face Overview"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.BuildStatusSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.BuildErrorSummary}"/><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button Padding="12,5" Content="Build Face" Command="{Binding FaceWorkspace.BuildFaceCommand}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Rebuild Face" Command="{Binding FaceWorkspace.RebuildFaceCommand}"/></StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Artwork"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkBuildSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkSourceSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkCalibrationSummary}"/><Button HorizontalAlignment="Left" Padding="12,5" Content="View Artwork" Command="{Binding FaceWorkspace.NavigateToArtworkCommand}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Components"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ComponentsProvenanceSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ComponentsSummary}"/><StackPanel Orientation="Horizontal"><Button Padding="12,5" Content="View Components" Command="{Binding FaceWorkspace.NavigateToComponentsCommand}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Edit Components" Command="{Binding FaceWorkspace.NavigateToComponentsEditorCommand}"/></StackPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Illumination"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.IlluminationBuildSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.IlluminationSummary}"/><Button HorizontalAlignment="Left" Padding="12,5" Content="View Illumination" Command="{Binding FaceWorkspace.NavigateToIlluminationCommand}"/></StackPanel></Border>
   </StackPanel>
   <Border Margin="0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Artwork}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Artwork"/><TextBlock Style="{StaticResource Summary}" Text="Source" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkSourceSummary}"/><WrapPanel Margin="0,0,0,14"><Button Padding="12,5" Content="Use Image..." Command="{Binding FaceWorkspace.UseImageCommand}" Visibility="{Binding FaceWorkspace.CanChooseImageArtwork, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Padding="12,5" Content="Use Panel2D Source" Command="{Binding FaceWorkspace.UsePanel2DSourceCommand}" Visibility="{Binding FaceWorkspace.CanShowUsePanel2DSource, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Replace Image..." Command="{Binding FaceWorkspace.UseImageCommand}" Visibility="{Binding FaceWorkspace.IsImageArtworkSource, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Reload" Command="{Binding FaceWorkspace.ReloadImageCommand}" Visibility="{Binding FaceWorkspace.IsImageArtworkSource, Converter={StaticResource BooleanToVisibilityConverter}}"/></WrapPanel><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.Panel2DSourceAvailability}"/><TextBlock Style="{StaticResource Summary}" Text="Geometry" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkGeometrySummary}"/><TextBlock Style="{StaticResource Summary}" Text="Correction" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkCorrectionSummary}"/><WrapPanel><Button Padding="12,5" Content="Edit Registration" Command="{Binding FaceWorkspace.NavigateToArtworkGeometryCommand}" Visibility="{Binding FaceWorkspace.IsImageArtworkSource, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Edit Calibration" Command="{Binding FaceWorkspace.NavigateToArtworkCalibrationCommand}"/></WrapPanel><TextBlock Style="{StaticResource Summary}" Margin="0,18,0,10" Text="Base Artwork" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkBaseSummary}"/><TextBlock Style="{StaticResource Summary}" Text="Override" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkOverrideSummary}"/><WrapPanel Margin="0,0,0,14"><Button Padding="12,5" Content="Create From Base" Command="{Binding FaceWorkspace.CreateOverrideFromBaseCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Import..." Command="{Binding FaceWorkspace.ImportOverrideCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Edit Alignment" Command="{Binding FaceWorkspace.NavigateToArtworkOverrideCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Reload" Command="{Binding FaceWorkspace.ReloadOverrideCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Replace..." Command="{Binding FaceWorkspace.ReplaceOverrideCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="{Binding FaceWorkspace.OverrideToggleLabel}" Command="{Binding FaceWorkspace.ToggleOverrideCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Remove" Command="{Binding FaceWorkspace.RemoveOverrideCommand}"/></WrapPanel><TextBlock Style="{StaticResource Summary}" Text="Output" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ArtworkOutputSummary}"/></StackPanel></Border>
   <Border Margin="0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Components}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Components"/><TextBlock Style="{StaticResource Summary}" Text="Face objects remain listed and selectable in the Hierarchy."/><TextBlock Style="{StaticResource Summary}" FontWeight="SemiBold" Text="{Binding FaceWorkspace.ComponentsProvenanceSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.ComponentsSummary}"/><WrapPanel><Button Padding="12,5" Content="Edit Components" Command="{Binding FaceWorkspace.NavigateToComponentsEditorCommand}"/><Button Margin="8,0,0,0" Padding="12,5" Content="Rebuild From Source..." Command="{Binding FaceWorkspace.RebuildComponentsFromSourceCommand}"/></WrapPanel></StackPanel></Border>
   <Border Margin="0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.Illumination}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Illumination"/><TextBlock Style="{StaticResource Summary}" Text="Current lamp, generated mask, tray, and emitter information."/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.IlluminationBuildSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.BuildErrorSummary}"/><TextBlock Style="{StaticResource Summary}" Text="{Binding FaceWorkspace.IlluminationSummary}"/><TextBlock Style="{StaticResource Summary}" Text="Lamp Mask: RGB intensity controls transmission; black is opaque and white is fully transmissive. Alpha is preserved."/><WrapPanel><Button Padding="12,5" Content="Use Authored Image..." Command="{Binding FaceWorkspace.UseAuthoredMaskCommand}"/><Button HorizontalAlignment="Left" Padding="12,5" Content="Edit Lamps" Command="{Binding FaceWorkspace.NavigateToIlluminationLampsCommand}"/><Button Margin="6,0,0,0" Padding="12,5" Content="Add Lamp" Command="{Binding FaceWorkspace.AddLampCommand}"/></WrapPanel></StackPanel></Border>
   </Grid></ScrollViewer>
   <Grid ClipToBounds="True" Background="{DynamicResource PanelBackgroundBrush}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.IsViewportDestination}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Panel.ZIndex="5" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Padding="10,6" Background="{DynamicResource ToolBarBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.ComponentsEditor}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Text="Add:"/><Button Padding="9,4" Content="Reel" Command="{Binding FaceWorkspace.AddReelCommand}"/><Button Margin="6,0,0,0" Padding="9,4" Content="Button" Command="{Binding FaceWorkspace.AddButtonCommand}"/><Button Margin="6,0,0,0" Padding="9,4" Content="7 Segment" Command="{Binding FaceWorkspace.AddSevenSegmentCommand}"/><Button Margin="6,0,0,0" Padding="9,4" Content="Alpha Display" Command="{Binding FaceWorkspace.AddAlphaDisplayCommand}"/></StackPanel><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding FaceWorkspace.ComponentEditorStatus}"/></StackPanel></Border><Border Panel.ZIndex="6" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Padding="10,6" Background="{DynamicResource ToolBarBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.IlluminationLamps}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><Button Padding="9,4" Content="Add Lamp" Command="{Binding FaceWorkspace.AddLampCommand}"/><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding FaceWorkspace.LampEditorStatus}"/></StackPanel></Border><Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.ArtworkOverride}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Viewbox Stretch="Uniform"><Grid Width="1000" Height="1000"><Image Source="{Binding FaceWorkspace.ArtworkBaseAbsolutePath}" Stretch="Fill"/><Image Source="{Binding FaceWorkspace.ArtworkOverrideAbsolutePath}" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding FaceWorkspace.OverridePreviewMargin}" Width="{Binding FaceWorkspace.OverridePreviewWidth}" Height="{Binding FaceWorkspace.OverridePreviewHeight}" Opacity="{Binding FaceWorkspace.OverridePreviewOpacity}"/><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding FaceWorkspace.OverridePreviewMargin}" Width="{Binding FaceWorkspace.OverridePreviewWidth}" Height="{Binding FaceWorkspace.OverridePreviewHeight}"/></Grid></Viewbox><Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Padding="10" Background="{DynamicResource ToolBarBackgroundBrush}"><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="Preview Opacity"/><Slider Margin="8,0" Width="180" Minimum="0" Maximum="1" Value="{Binding FaceWorkspace.OverridePreviewOpacity}"/><Button Content="Reset Alignment" Command="{Binding FaceWorkspace.ResetOverrideAlignmentCommand}"/><Button Margin="6,0,0,0" Content="Done" Command="{Binding FaceWorkspace.DoneOverrideAlignmentCommand}"/></StackPanel></Border></Grid><views:FaceArtworkRegistrationView><views:FaceArtworkRegistrationView.Style><Style TargetType="views:FaceArtworkRegistrationView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.ArtworkGeometry}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:FaceArtworkRegistrationView.Style></views:FaceArtworkRegistrationView><views:SkiaFaceEditView><views:SkiaFaceEditView.Style><Style TargetType="views:SkiaFaceEditView"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.ArtworkGeometry}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding FaceWorkspace.Destination}" Value="{x:Static local:FaceWorkspaceDestination.ArtworkOverride}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:SkiaFaceEditView.Style></views:SkiaFaceEditView></Grid>
  </Grid>
 </Grid>
</UserControl>
