<UserControl x:Class="OasisEditor.Views.Mpu5FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Barcrest MPU5 / Fabric" />
    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="ROM resources belong to the current project. The Fabric runtime and MPU5 provider paths are configured globally in Preferences." />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Program ROM 1"/><TextBox Grid.Row="0" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom1Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="0" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5ProgramRom1Command}" Content="Browse"/>
      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Program ROM 2"/><TextBox Grid.Row="1" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom2Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="1" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5ProgramRom2Command}" Content="Browse"/>
      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Program ROM 3"/><TextBox Grid.Row="2" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom3Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="2" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5ProgramRom3Command}" Content="Browse"/>
      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Program ROM 4"/><TextBox Grid.Row="3" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom4Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="3" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5ProgramRom4Command}" Content="Browse"/>
      <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Sound ROM 1"/><TextBox Grid.Row="4" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom1Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="4" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5SoundRom1Command}" Content="Browse"/>
      <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Sound ROM 2"/><TextBox Grid.Row="5" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom2Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="5" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5SoundRom2Command}" Content="Browse"/>
      <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Sound ROM 3"/><TextBox Grid.Row="6" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom3Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="6" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5SoundRom3Command}" Content="Browse"/>
      <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Sound ROM 4"/><TextBox Grid.Row="7" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom4Path, UpdateSourceTrigger=LostFocus}"/><Button Grid.Row="7" Grid.Column="2" Padding="10,2" Command="{Binding BrowseMpu5SoundRom4Command}" Content="Browse"/>
      <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding Mpu5NativeRomStatus, StringFormat=Status: {0}}" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
  </StackPanel>
</UserControl>
