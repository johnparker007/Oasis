<UserControl x:Class="OasisEditor.Views.Mpu5FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OasisEditor">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Barcrest MPU5 / Fabric"/><TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="Project-specific MPU5 configuration. Runtime and provider DLL paths are global Preferences."/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Margin="10,4" Text="{Binding Mpu5NativeRomStatus, StringFormat=Status: {0}}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
  <TabControl>
   <TabItem Header="ROMs"><ScrollViewer><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Program ROM 1"/><TextBox Grid.Row="0" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom1Path}"/><Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom1Command}" Content="Browse"/>
    <TextBlock Grid.Row="1" Text="Program ROM 2"/><TextBox Grid.Row="1" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom2Path}"/><Button Grid.Row="1" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom2Command}" Content="Browse"/>
    <TextBlock Grid.Row="2" Text="Program ROM 3"/><TextBox Grid.Row="2" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom3Path}"/><Button Grid.Row="2" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom3Command}" Content="Browse"/>
    <TextBlock Grid.Row="3" Text="Program ROM 4"/><TextBox Grid.Row="3" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom4Path}"/><Button Grid.Row="3" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom4Command}" Content="Browse"/>
    <TextBlock Grid.Row="4" Text="Sound ROM 1"/><TextBox Grid.Row="4" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom1Path}"/><Button Grid.Row="4" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom1Command}" Content="Browse"/>
    <TextBlock Grid.Row="5" Text="Sound ROM 2"/><TextBox Grid.Row="5" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom2Path}"/><Button Grid.Row="5" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom2Command}" Content="Browse"/>
    <TextBlock Grid.Row="6" Text="Sound ROM 3"/><TextBox Grid.Row="6" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom3Path}"/><Button Grid.Row="6" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom3Command}" Content="Browse"/>
    <TextBlock Grid.Row="7" Text="Sound ROM 4"/><TextBox Grid.Row="7" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom4Path}"/><Button Grid.Row="7" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom4Command}" Content="Browse"/>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="Reels"><StackPanel Margin="8"><CheckBox Content="Configure reel section" IsChecked="{Binding Mpu5ProjectSettings.ConfigureReels, UpdateSourceTrigger=PropertyChanged}"/><DataGrid Margin="0,8" ItemsSource="{Binding Mpu5ProjectSettings.Reels}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Reel" Binding="{Binding ReelIndex}" IsReadOnly="True"/><DataGridTextColumn Header="Steps" Binding="{Binding Steps, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><DataGridTextColumn Header="Opto start" Binding="{Binding OptoStart, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><DataGridTextColumn Header="Opto end" Binding="{Binding OptoEnd, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><DataGridCheckBoxColumn Header="Invert" Binding="{Binding OptoInvert, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><CheckBox Content="Apply controller 0 jumper" IsChecked="{Binding Mpu5ProjectSettings.ApplyReelJumperProfile0, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Margin="8,0" Width="180" ItemsSource="{Binding Mpu5ReelJumperProfiles}" SelectedItem="{Binding Mpu5ProjectSettings.ReelJumperProfile0, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Apply controller 1 jumper" IsChecked="{Binding Mpu5ProjectSettings.ApplyReelJumperProfile1, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Margin="8,0" Width="180" ItemsSource="{Binding Mpu5ReelJumperProfiles}" SelectedItem="{Binding Mpu5ProjectSettings.ReelJumperProfile1, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></StackPanel></TabItem>
   <TabItem Header="Coins"><StackPanel Margin="8"><CheckBox Content="Configure coin section" IsChecked="{Binding Mpu5ProjectSettings.ConfigureCoins, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="Communication"/><ComboBox Margin="8,0" ItemsSource="{Binding Mpu5CoinCommunicationStyles}" SelectedItem="{Binding Mpu5ProjectSettings.CommunicationStyle, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Margin="12,0" Content="Invert" IsChecked="{Binding Mpu5ProjectSettings.CommunicationInvert, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Pulse cycles"/><TextBox Margin="8,0" Width="100" Text="{Binding Mpu5ProjectSettings.PulseCycles, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><CheckBox Content="EDC" IsChecked="{Binding Mpu5ProjectSettings.EdcEnabled, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><DataGrid ItemsSource="{Binding Mpu5ProjectSettings.Coins}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}" IsReadOnly="True"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><DataGridCheckBoxColumn Header="Lockout invert" Binding="{Binding LockoutInvert, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Machine Options"><ScrollViewer><StackPanel Margin="8"><CheckBox Content="Configure machine options section" IsChecked="{Binding Mpu5ProjectSettings.ConfigureMachineOptions, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <CheckBox Grid.Row="0" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyDips, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="DIP switch bits (0..65535)"/><TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Mpu5ProjectSettings.DipSwitchBits, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
    <CheckBox Grid.Row="1" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyStake, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Stake selector"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Mpu5ProjectSettings.Stake, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
    <CheckBox Grid.Row="2" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyPrize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Prize selector"/><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Mpu5ProjectSettings.Prize, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
    <CheckBox Grid.Row="3" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyPercentage, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Percentage (0=None; 1=70% … 15=98%)"/><TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Mpu5ProjectSettings.Percentage, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
    <CheckBox Grid.Row="4" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyCharacteriserAddress, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Characteriser address"/><TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Mpu5ProjectSettings.CharacteriserAddress, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
    <CheckBox Grid.Row="5" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyPicMode, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="PIC mode"/><ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Mpu5PicModes}" SelectedItem="{Binding Mpu5ProjectSettings.PicMode, UpdateSourceTrigger=PropertyChanged}"/>
    <CheckBox Grid.Row="6" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplySecFitted, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="SEC fitted"/><CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding Mpu5ProjectSettings.SecFitted, UpdateSourceTrigger=PropertyChanged}"/>
    <CheckBox Grid.Row="7" Content="Apply" IsChecked="{Binding Mpu5ProjectSettings.ApplyHopperType, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Hopper type"/><ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Mpu5HopperTypes}" SelectedItem="{Binding Mpu5ProjectSettings.HopperType, UpdateSourceTrigger=PropertyChanged}"/>
   </Grid></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
