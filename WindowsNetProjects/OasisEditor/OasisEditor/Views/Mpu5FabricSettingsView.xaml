<UserControl x:Class="OasisEditor.Views.Mpu5FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OasisEditor">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Barcrest MPU5 / Fabric"/><TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="Project-specific MPU5 configuration. Runtime and provider DLL paths are global Preferences."/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Padding="12,3" Command="{Binding SaveMpu5ProjectSettingsCommand}" Content="Apply MPU5 Settings"/><TextBlock Margin="10,4" Text="{Binding Mpu5NativeRomStatus, StringFormat=Status: {0}}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
  <TabControl>
   <TabItem Header="ROMs"><ScrollViewer><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Program ROM 1"/><TextBox Grid.Row="0" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom1Path}"/><Button Grid.Row="0" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom1Command}" Content="Browse"/>
    <TextBlock Grid.Row="1" Text="Program ROM 2"/><TextBox Grid.Row="1" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom2Path}"/><Button Grid.Row="1" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom2Command}" Content="Browse"/>
    <TextBlock Grid.Row="2" Text="Program ROM 3"/><TextBox Grid.Row="2" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom3Path}"/><Button Grid.Row="2" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom3Command}" Content="Browse"/>
    <TextBlock Grid.Row="3" Text="Program ROM 4"/><TextBox Grid.Row="3" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5ProgramRom4Path}"/><Button Grid.Row="3" Grid.Column="2" Command="{Binding BrowseMpu5ProgramRom4Command}" Content="Browse"/>
    <TextBlock Grid.Row="4" Text="Sound ROM 1"/><TextBox Grid.Row="4" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom1Path}"/><Button Grid.Row="4" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom1Command}" Content="Browse"/>
    <TextBlock Grid.Row="5" Text="Sound ROM 2"/><TextBox Grid.Row="5" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom2Path}"/><Button Grid.Row="5" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom2Command}" Content="Browse"/>
    <TextBlock Grid.Row="6" Text="Sound ROM 3"/><TextBox Grid.Row="6" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom3Path}"/><Button Grid.Row="6" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom3Command}" Content="Browse"/>
    <TextBlock Grid.Row="7" Text="Sound ROM 4"/><TextBox Grid.Row="7" Grid.Column="1" Margin="8,3" Text="{Binding Mpu5SoundRom4Path}"/><Button Grid.Row="7" Grid.Column="2" Command="{Binding BrowseMpu5SoundRom4Command}" Content="Browse"/>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="Reels"><StackPanel Margin="8"><CheckBox Content="Configure reel section" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ConfigureReels}"/><DataGrid Margin="0,8" ItemsSource="{Binding LoadedProject.Mpu5NativeRoms.Reels}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply}"/><DataGridTextColumn Header="Reel" Binding="{Binding ReelIndex}" IsReadOnly="True"/><DataGridTextColumn Header="Steps" Binding="{Binding Steps}"/><DataGridTextColumn Header="Opto start" Binding="{Binding OptoStart}"/><DataGridTextColumn Header="Opto end" Binding="{Binding OptoEnd}"/><DataGridCheckBoxColumn Header="Invert" Binding="{Binding OptoInvert}"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><CheckBox Content="Apply controller 0 jumper" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyReelJumperProfile0}"/><ComboBox Margin="8,0" Width="180" ItemsSource="{Binding Mpu5ReelJumperProfiles}" SelectedItem="{Binding LoadedProject.Mpu5NativeRoms.ReelJumperProfile0}"/><CheckBox Content="Apply controller 1 jumper" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyReelJumperProfile1}"/><ComboBox Margin="8,0" Width="180" ItemsSource="{Binding Mpu5ReelJumperProfiles}" SelectedItem="{Binding LoadedProject.Mpu5NativeRoms.ReelJumperProfile1}"/></StackPanel></StackPanel></TabItem>
   <TabItem Header="Coins"><StackPanel Margin="8"><CheckBox Content="Configure coin section" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ConfigureCoins}"/><StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="Communication"/><ComboBox Margin="8,0" ItemsSource="{Binding Mpu5CoinCommunicationStyles}" SelectedItem="{Binding LoadedProject.Mpu5NativeRoms.CommunicationStyle}"/><CheckBox Margin="12,0" Content="Invert" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.CommunicationInvert}"/><TextBlock Text="Pulse cycles"/><TextBox Margin="8,0" Width="100" Text="{Binding LoadedProject.Mpu5NativeRoms.PulseCycles}"/><CheckBox Content="EDC" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.EdcEnabled}"/></StackPanel><DataGrid ItemsSource="{Binding LoadedProject.Mpu5NativeRoms.Coins}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply}"/><DataGridTextColumn Header="Channel" Binding="{Binding Channel}" IsReadOnly="True"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Value" Binding="{Binding Value}"/><DataGridCheckBoxColumn Header="Lockout invert" Binding="{Binding LockoutInvert}"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
   <TabItem Header="Machine Options"><ScrollViewer><StackPanel Margin="8"><CheckBox Content="Configure machine options section" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ConfigureMachineOptions}"/><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <CheckBox Grid.Row="0" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyDips}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="DIP switch bits (0..65535)"/><TextBox Grid.Row="0" Grid.Column="2" Text="{Binding LoadedProject.Mpu5NativeRoms.DipSwitchBits}"/>
    <CheckBox Grid.Row="1" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyStake}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Stake selector"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding LoadedProject.Mpu5NativeRoms.Stake}"/>
    <CheckBox Grid.Row="2" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyPrize}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Prize selector"/><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding LoadedProject.Mpu5NativeRoms.Prize}"/>
    <CheckBox Grid.Row="3" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyPercentage}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Percentage (0=None; 1=70% … 15=98%)"/><TextBox Grid.Row="3" Grid.Column="2" Text="{Binding LoadedProject.Mpu5NativeRoms.Percentage}"/>
    <CheckBox Grid.Row="4" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyCharacteriserAddress}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Characteriser address"/><TextBox Grid.Row="4" Grid.Column="2" Text="{Binding LoadedProject.Mpu5NativeRoms.CharacteriserAddress}"/>
    <CheckBox Grid.Row="5" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyPicMode}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="PIC mode"/><ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Mpu5PicModes}" SelectedItem="{Binding LoadedProject.Mpu5NativeRoms.PicMode}"/>
    <CheckBox Grid.Row="6" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplySecFitted}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="SEC fitted"/><CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.SecFitted}"/>
    <CheckBox Grid.Row="7" Content="Apply" IsChecked="{Binding LoadedProject.Mpu5NativeRoms.ApplyHopperType}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Hopper type"/><ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Mpu5HopperTypes}" SelectedItem="{Binding LoadedProject.Mpu5NativeRoms.HopperType}"/>
   </Grid></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
