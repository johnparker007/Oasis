<UserControl x:Class="OasisEditor.Views.M1FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Maygay M1 / Fabric"/><TabControl Margin="0,8,0,0"><TabItem Header="ROMs"><StackPanel><DataGrid ItemsSource="{Binding M1ProjectSettings.ProgramRoms}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding Slot}"/><DataGridTextColumn Header="Program ROM path" Width="*" Binding="{Binding Path}"/></DataGrid.Columns></DataGrid><DataGrid ItemsSource="{Binding M1ProjectSettings.SoundRoms}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding Slot}"/><DataGridTextColumn Header="Sound ROM path" Width="*" Binding="{Binding Path}"/></DataGrid.Columns></DataGrid></StackPanel></TabItem><TabItem Header="Reels"><DataGrid ItemsSource="{Binding M1ProjectSettings.Reels}" AutoGenerateColumns="True"/></TabItem><TabItem Header="DIP switches"><ItemsControl ItemsSource="{Binding M1ProjectSettings.Dips}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayNumber, StringFormat=DIP {0}}" IsChecked="{Binding IsEnabled}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem><TabItem Header="Machine options"><StackPanel><ComboBox ItemsSource="{Binding M1ProjectSettings.PercentageChoices}" SelectedIndex="{Binding M1ProjectSettings.PercentageKey}"/><CheckBox Content="EDC enabled" IsChecked="{Binding M1ProjectSettings.EdcEnabled}"/></StackPanel></TabItem><TabItem Header="Hoppers"><DataGrid ItemsSource="{Binding M1ProjectSettings.Hoppers}" AutoGenerateColumns="True"/></TabItem></TabControl></DockPanel></UserControl>
