<UserControl x:Class="OasisEditor.Views.Mpu3FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel><TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Barcrest MPU3 / Fabric"/><TabControl Margin="0,8,0,0">
  <TabItem Header="ROMs"><DataGrid Margin="8" ItemsSource="{Binding Mpu3ProjectSettings.ProgramRoms}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" IsReadOnly="True"/><DataGridTextColumn Header="Program ROM path" Width="*" Binding="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><DataGridTextColumn Header="Load address" Binding="{Binding LoadAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/></DataGrid.Columns></DataGrid></TabItem>
  <TabItem Header="Reels"><DataGrid Margin="8" ItemsSource="{Binding Mpu3ProjectSettings.Reels}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Reel" Binding="{Binding ReelIndex}" IsReadOnly="True"/><DataGridTextColumn Header="Steps" Binding="{Binding Steps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><DataGridTextColumn Header="Opto Start" Binding="{Binding OptoStart, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><DataGridTextColumn Header="Opto End" Binding="{Binding OptoEnd, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><DataGridCheckBoxColumn Header="Opto Invert" Binding="{Binding OptoInvert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid></TabItem>
  <TabItem Header="DIP switches"><ItemsControl Margin="8" ItemsSource="{Binding Mpu3ProjectSettings.Dips}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayNumber}" ContentStringFormat="DIP {0}" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem>
 </TabControl></DockPanel>
</UserControl>
