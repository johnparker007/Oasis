<UserControl x:Class="OasisEditor.Views.FaceArtworkRegistrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:OasisEditor.Views">
 <Grid Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" ClipToBounds="True">
  <Canvas x:Name="ImageCanvas" IsHitTestVisible="False">
   <Image x:Name="SourceImage" Source="{Binding FaceWorkspace.GeometryRawImage}" Stretch="Fill"/>
  </Canvas>
  <Canvas x:Name="Overlay" Background="Transparent" MouseDown="OnDown" MouseMove="OnMove" MouseLeave="OnMouseLeave" MouseUp="OnUp"
          MouseWheel="OnMouseWheel" LostMouseCapture="OnLostMouseCapture" SizeChanged="OnSizeChanged"/>
  <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="12">
   <Button Padding="10,5" Content="Apply / Build" Command="{Binding FaceWorkspace.BuildFaceCommand}"/>
   <Button Margin="8,0" Padding="10,5" Content="Reset to Full Image" Click="OnReset"/>
   <Button Padding="10,5" Content="Done" Command="{Binding FaceWorkspace.DoneGeometryCommand}"/>
  </StackPanel>
  </Grid>
  <views:EditorViewportStatusBar x:Name="ViewportStatus" Grid.Row="1" FitRequested="OnFitRequested" ZoomRequested="OnZoomRequested"/>
 </Grid>
</UserControl>
