<UserControl x:Class="OasisEditor.Views.Scorpion4FabricSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Bell-Fruit Scorpion 4 / Fabric"/><TabControl Margin="0,8,0,0"><TabItem Header="ROMs"><StackPanel><DataGrid ItemsSource="{Binding Scorpion4ProjectSettings.ProgramRoms}" AutoGenerateColumns="True" CanUserAddRows="False"/><DataGrid ItemsSource="{Binding Scorpion4ProjectSettings.SoundRoms}" AutoGenerateColumns="True" CanUserAddRows="False"/></StackPanel></TabItem><TabItem Header="Reels"><DataGrid ItemsSource="{Binding Scorpion4ProjectSettings.Reels}" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem><TabItem Header="DIP switches"><ItemsControl ItemsSource="{Binding Scorpion4ProjectSettings.Dips}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayNumber, StringFormat=DIP {0}}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem><TabItem Header="Machine options"><StackPanel><TextBlock Text="Stake"/><ComboBox ItemsSource="{Binding Scorpion4ProjectSettings.StakeChoices}" SelectedIndex="{Binding Scorpion4ProjectSettings.Stake}"/><TextBlock Text="Prize / Jackpot"/><ComboBox ItemsSource="{Binding Scorpion4ProjectSettings.PrizeChoices}" SelectedIndex="{Binding Scorpion4ProjectSettings.Prize}"/><TextBlock Text="Percentage"/><ComboBox ItemsSource="{Binding Scorpion4ProjectSettings.PercentageChoices}" SelectedIndex="{Binding Scorpion4ProjectSettings.Percentage}"/><CheckBox Content="EDC enabled" IsChecked="{Binding Scorpion4ProjectSettings.EdcEnabled}"/><ComboBox ItemsSource="{Binding Scorpion4ProjectSettings.HopperTypeChoices}" SelectedIndex="{Binding Scorpion4ProjectSettings.HopperType}"/></StackPanel></TabItem><TabItem Header="Coins"><DataGrid ItemsSource="{Binding Scorpion4ProjectSettings.Coins}" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem><TabItem Header="Hoppers"><DataGrid ItemsSource="{Binding Scorpion4ProjectSettings.Hoppers}" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem></TabControl></DockPanel></UserControl>
