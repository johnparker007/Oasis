<UserControl x:Class="OasisEditor.Views.InputMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add Input" Command="{Binding AddInputCommand}" Padding="10,4" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Logical declarations; Player development bindings are configured in Unity." />
        </StackPanel>
        <Border Grid.Row="1" Padding="8" Margin="0,0,0,8"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInputCreation}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel DataContext="{Binding InputCreation}">
                <TextBlock Text="{Binding MachineName, StringFormat='Add input to {0}'}" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,2" Text="Logical ID (raw ID, e.g. rerack or newGame)" />
                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,2" Text="Display name (optional)" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Error}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Create" Command="{Binding CreateCommand}" Padding="10,4" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="10,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="InputMapGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding InputDefinitions}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CellEditEnding="InputMapGrid_OnCellEditEnding"
                  PreviewKeyDown="InputMapGrid_OnPreviewKeyDown"
                  PreviewMouseRightButtonDown="InputMapGrid_OnPreviewMouseRightButtonDown"
                  Unloaded="InputMapGrid_OnUnloaded">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="InputMapContextMenu_OnOpened">
                    <MenuItem x:Name="DeleteMenuItem"
                              Header="_Delete"
                              Click="DeleteMenuItem_OnClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Logical ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="1.1*" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="1.2*" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, UpdateSourceTrigger=LostFocus}" Width="0.7*" />
                <DataGridTextColumn Header="Button No" Binding="{Binding ButtonNumber, UpdateSourceTrigger=LostFocus}" Width="0.8*" />
                <DataGridCheckBoxColumn Header="Coin" Binding="{Binding CoinInput, UpdateSourceTrigger=LostFocus}" Width="0.6*" />
                <DataGridTextColumn Header="Coin Channel (0-5)" Binding="{Binding CoinChannel, UpdateSourceTrigger=LostFocus}" Width="1.0*" />
                <DataGridTextColumn Header="Coin Value / Denomination (0-12)" Binding="{Binding CoinValue, UpdateSourceTrigger=LostFocus}" Width="1.4*" />
                <DataGridTextColumn Header="Key" Binding="{Binding KeyboardShortcut, UpdateSourceTrigger=LostFocus}" Width="0.8*" />
                <DataGridTextColumn Header="Raw MFME Key" Binding="{Binding RawMfmeShortcut, UpdateSourceTrigger=LostFocus}" Width="0.9*" />
                <DataGridTextColumn Header="Linked Visual" Binding="{Binding LinkedVisualElementId, UpdateSourceTrigger=LostFocus}" Width="1.3*" />
                <DataGridCheckBoxColumn Header="Inverted" Binding="{Binding Inverted, UpdateSourceTrigger=LostFocus}" Width="0.8*" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=LostFocus}" Width="1.3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceRaisedBrush}">
            <StackPanel>
                <DockPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Input Map Diagnostics" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding InputMapWarningCount, StringFormat=Warnings: {0}}" />
                </DockPanel>
                <ItemsControl Margin="0,6,0,0"
                              ItemsSource="{Binding InputMapDiagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="[" />
                                <Run Text="{Binding Severity}" />
                                <Run Text="] " />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="No input map diagnostics.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInputMapDiagnostics}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
