<UserControl x:Class="OasisEditor.Features.CabinetEditor.Views.CabinetModelDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding CabinetViewer.DisplayName}" />
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CabinetViewer.LoadStatus}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="10,4" Margin="0,0,8,0" Command="{Binding CabinetViewer.ReloadCommand}" Content="Reload" />
                <Button Padding="10,4" Command="{Binding CabinetViewer.ResetCameraCommand}" Content="Reset Camera" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <h:HelixViewport3D Grid.Column="0"
                              ShowCoordinateSystem="False"
                              ShowViewCube="False"
                              IsHeadLightEnabled="False"
                              CameraRotationMode="Turntable"
                              ModelUpDirection="0,1,0"
                              RotateAroundMouseDownPoint="False">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="{Binding CabinetViewer.Viewport.CameraPosition, Mode=TwoWay}"
                                       LookDirection="{Binding CabinetViewer.Viewport.CameraLookDirection, Mode=TwoWay}"
                                       UpDirection="{Binding CabinetViewer.Viewport.CameraUpDirection, Mode=TwoWay}"
                                       FieldOfView="{Binding CabinetViewer.Viewport.CameraFieldOfView, Mode=TwoWay}" />
                </h:HelixViewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#666666" />
                            <DirectionalLight Color="#F4F4F4" Direction="-0.45,-0.8,-0.35" />
                            <DirectionalLight Color="#8C98AA" Direction="0.6,-0.35,0.55" />
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <h:GridLinesVisual3D Width="{Binding CabinetViewer.Viewport.GridWidth}"
                                     Length="{Binding CabinetViewer.Viewport.GridLength}"
                                     MinorDistance="{Binding CabinetViewer.Viewport.GridMinorDistance}"
                                     Normal="0,1,0"
                                     LengthDirection="1,0,0"
                                     Thickness="0.01" />
                <h:ArrowVisual3D Point1="0,0,0" Point2="{Binding CabinetViewer.Viewport.XAxisEnd}" Diameter="0.025" Fill="Red" />
                <h:ArrowVisual3D Point1="0,0,0" Point2="{Binding CabinetViewer.Viewport.YAxisEnd}" Diameter="0.025" Fill="LimeGreen" />
                <h:ArrowVisual3D Point1="0,0,0" Point2="{Binding CabinetViewer.Viewport.ZAxisEnd}" Diameter="0.025" Fill="DodgerBlue" />
                <ModelVisual3D Content="{Binding CabinetViewer.Viewport.Model}" />
                <ModelVisual3D Content="{Binding CabinetViewer.Viewport.FacePreviewModel}" />
            </h:HelixViewport3D>

            <Border Grid.Column="1" Margin="8,0,0,0" Padding="12"
                    Background="{DynamicResource ToolBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Expander DockPanel.Dock="Bottom" Margin="0,12,0,0" Header="Reflection Receivers" IsExpanded="False" DataContext="{Binding CabinetViewer.ReflectionEditor}">
                        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal"><Button Margin="0,0,5,0" Command="{Binding AddCommand}" Content="Add"/><Button Margin="0,0,5,0" Command="{Binding DuplicateCommand}" Content="Duplicate"/><Button Margin="0,0,5,0" Command="{Binding RemoveCommand}" Content="Remove"/><Button Command="{Binding RefreshCommand}" Content="Refresh"/></StackPanel>
                                <ListBox Height="90" Margin="0,6,0,6" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Id"/>
                                <StackPanel IsEnabled="{Binding HasSelection}">
                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}"/>
                                    <TextBlock Margin="0,5,0,2" Text="Receiver ID"/><TextBox Text="{Binding Id, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Margin="0,5,0,2" Text="Cabinet Renderer"/><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="DisplayName"/>
                                    <TextBlock Margin="0,5,0,2" Text="Material Slot"/><ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" DisplayMemberPath="DisplayName"/>
                                    <TextBlock Margin="0,5,0,2" Text="Surface Preset"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/>
                                    <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Source Faces"/>
                                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate><DataTemplate><Expander Margin="0,2" Header="{Binding Choice.Label}" IsExpanded="True"><StackPanel Margin="8,3,0,5">
                                            <ComboBox ItemsSource="{Binding DataContext.FaceChoices, RelativeSource={RelativeSource AncestorType=ListBox}}" SelectedItem="{Binding Choice}" DisplayMemberPath="Label"/>
                                            <TextBlock Margin="0,4,0,2" Text="Plane Source"/><ComboBox ItemsSource="{Binding DataContext.PlaneSources, RelativeSource={RelativeSource AncestorType=ListBox}}" SelectedItem="{Binding PlaneSource}"/>
                                            <Button Margin="0,4,0,0" Command="{Binding DataContext.DeriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" Content="Derive Plane"/>
                                            <TextBlock Margin="0,5,0,2" Text="Origin X / Y / Z"/><StackPanel Orientation="Horizontal"><TextBox Width="65" Text="{Binding OriginX}"/><TextBox Width="65" Text="{Binding OriginY}"/><TextBox Width="65" Text="{Binding OriginZ}"/></StackPanel>
                                            <TextBlock Margin="0,5,0,2" Text="Right X / Y / Z"/><StackPanel Orientation="Horizontal"><TextBox Width="65" Text="{Binding RightX}"/><TextBox Width="65" Text="{Binding RightY}"/><TextBox Width="65" Text="{Binding RightZ}"/></StackPanel>
                                            <TextBlock Margin="0,5,0,2" Text="Up X / Y / Z"/><StackPanel Orientation="Horizontal"><TextBox Width="65" Text="{Binding UpX}"/><TextBox Width="65" Text="{Binding UpY}"/><TextBox Width="65" Text="{Binding UpZ}"/></StackPanel>
                                            <TextBlock Margin="0,5,0,2" Text="Width / Height"/><StackPanel Orientation="Horizontal"><TextBox Width="95" Text="{Binding Width}"/><TextBox Width="95" Text="{Binding Height}"/></StackPanel>
                                        </StackPanel></Expander></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal"><Button Margin="0,4,5,0" Command="{Binding AddSourceCommand}" Content="Add Source Face"/><Button Margin="0,4,0,0" Command="{Binding RemoveSourceCommand}" Content="Remove Source"/></StackPanel>
                                    <TextBlock Margin="0,5,0,2" Text="Visibility Mask (cabinet UVs; white=on)"/><TextBox Text="{Binding Mask}"/><StackPanel Orientation="Horizontal"><Button Margin="0,3,5,0" Command="{Binding BrowseMaskCommand}" Content="Choose..."/><Button Margin="0,3,0,0" Command="{Binding ClearMaskCommand}" Content="Clear"/></StackPanel>
                                    <TextBlock Margin="0,5,0,2" Text="Reflection / Artwork / Lamp Strength"/><StackPanel Orientation="Horizontal"><TextBox Width="65" Text="{Binding Strength}"/><TextBox Width="65" Text="{Binding Artwork}"/><TextBox Width="65" Text="{Binding Lamps}"/></StackPanel>
                                    <TextBlock Margin="0,5,0,2" Text="Roughness / Distortion"/><StackPanel Orientation="Horizontal"><TextBox Width="95" Text="{Binding Roughness}"/><TextBox Width="95" Text="{Binding Distortion}"/></StackPanel>
                                    <TextBlock Margin="0,5,0,2" Text="Fresnel Strength / Power / Edge Fade"/><StackPanel Orientation="Horizontal"><TextBox Width="65" Text="{Binding FresnelStrength}"/><TextBox Width="65" Text="{Binding FresnelPower}"/><TextBox Width="65" Text="{Binding EdgeFade}"/></StackPanel>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Validation}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Oasis Face Targets" />
                        <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Lamp Preview" />
                        <ComboBox ItemsSource="{Binding CabinetViewer.LampPreviewModeOptions}" SelectedItem="{Binding CabinetViewer.SelectedLampPreviewMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding CabinetViewer.FaceTargetStatus}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CabinetViewer.HasSelectedFaceTarget}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Target Mapping" />
                        <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Front Side" />
                        <ComboBox ItemsSource="{Binding CabinetViewer.FrontSideOptions}" SelectedItem="{Binding CabinetViewer.SelectedFrontSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,8,0,3" Foreground="{DynamicResource TextSecondaryBrush}" Text="Face Rotation" />
                        <ComboBox ItemsSource="{Binding CabinetViewer.FaceRotationOptions}" SelectedItem="{Binding CabinetViewer.SelectedFaceRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="0,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Content="Flip Horizontally" IsChecked="{Binding CabinetViewer.IsSelectedFaceFlippedHorizontally, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding CabinetViewer.FaceTargets}" SelectedItem="{Binding CabinetViewer.SelectedFaceTarget, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="8"
                                            Background="{DynamicResource PanelBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SourceName}" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Id, StringFormat=ID: {0}}" />
                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding StateText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="0" Margin="12" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    CornerRadius="4" Background="{DynamicResource ToolBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CabinetViewer.HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding CabinetViewer.ErrorMessage}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
