<UserControl x:Class="OasisEditor.Features.PrefabEditor.Views.PrefabEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OasisEditor"
             xmlns:h="http://helix-toolkit.org/wpf"
             Foreground="{DynamicResource TextPrimaryBrush}"
             MinWidth="480" MinHeight="280">
    <Grid Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="180" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="2*" MinWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="380" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="8" Padding="8" CornerRadius="4"
                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Prefab Hierarchy" FontSize="16" FontWeight="SemiBold" Margin="2,2,2,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Add Child" Command="{Binding AddChildCommand}" Padding="8,3" Margin="0,0,5,0" />
                        <Button Content="↑" ToolTip="Move up" Command="{Binding MoveUpCommand}" Padding="8,3" Margin="0,0,5,0" />
                        <Button Content="↓" ToolTip="Move down" Command="{Binding MoveDownCommand}" Padding="8,3" Margin="0,0,5,0" />
                        <Button Content="Remove" Command="{Binding RemoveNodeCommand}" Padding="8,3" />
                    </WrapPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding Nodes}" SelectedValuePath="Id" SelectedValue="{Binding SelectedNodeId, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,4">
                                <TextBlock Text="{Binding IndentedName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ComponentSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="5,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtleBrush}" />
        <Grid Grid.Column="2" Margin="8" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
                <TextBlock Text="Prefab Preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Reset Camera" Command="{Binding Preview.ResetCameraCommand}" Padding="8,3" />
                <CheckBox Content="Collider" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="{Binding Preview.Viewport.ShowCollisionMeshes}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <h:HelixViewport3D Grid.Row="1" ShowCoordinateSystem="True" ShowViewCube="False" IsHeadLightEnabled="False"
                               CameraRotationMode="Turntable" ModelUpDirection="0,1,0" RotateAroundMouseDownPoint="False">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="{Binding Preview.Viewport.CameraPosition, Mode=TwoWay}"
                                       LookDirection="{Binding Preview.Viewport.CameraLookDirection, Mode=TwoWay}"
                                       UpDirection="{Binding Preview.Viewport.CameraUpDirection, Mode=TwoWay}"
                                       FieldOfView="{Binding Preview.Viewport.CameraFieldOfView, Mode=TwoWay}" />
                </h:HelixViewport3D.Camera>
                <ModelVisual3D><ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#666666" /><DirectionalLight Color="#F4F4F4" Direction="-0.45,-0.8,-0.35" /><DirectionalLight Color="#8C98AA" Direction="0.6,-0.35,0.55" /></Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
                <h:GridLinesVisual3D Width="{Binding Preview.GridSize}" Length="{Binding Preview.GridSize}" MinorDistance="{Binding Preview.GridSpacing}" Normal="0,1,0" LengthDirection="1,0,0" Thickness="{Binding Preview.GridThickness}" />
                <ModelVisual3D Content="{Binding Preview.VisualModel}" />
                <ModelVisual3D Content="{Binding Preview.Viewport.ColliderPreviewModel}" />
            </h:HelixViewport3D>
            <DockPanel Grid.Row="2" Margin="8,4,8,8">
                <TextBlock Text="{Binding Preview.Status}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                <ItemsControl ItemsSource="{Binding Preview.Diagnostics}" />
            </DockPanel>
        </Grid>
        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtleBrush}" />
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="Prefab" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Asset name" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,12" />
                <TextBlock Text="Selected node" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding SelectedNodeName, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,10" />
                <TextBlock Text="Move under" Foreground="{DynamicResource TextSecondaryBrush}" />
                <DockPanel Margin="0,3,0,10"><Button DockPanel.Dock="Right" Content="Reparent" Command="{Binding ReparentSelectedCommand}" Padding="8,3" Margin="6,0,0,0" /><ComboBox ItemsSource="{Binding ReparentTargets}" DisplayMemberPath="IndentedName" SelectedValuePath="Id" SelectedValue="{Binding SelectedParentNodeId, Mode=TwoWay}" /></DockPanel>
                <TextBlock Text="Local Transform" FontWeight="SemiBold" Margin="0,4,0,5" />
                <TextBlock Text="Position" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid Columns="3" Margin="0,3,0,7">
                    <TextBox Text="{Binding PositionX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding PositionY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding PositionZ, UpdateSourceTrigger=LostFocus}" />
                </UniformGrid>
                <TextBlock Text="Rotation (degrees)" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid Columns="3" Margin="0,3,0,7">
                    <TextBox Text="{Binding RotationX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding RotationY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding RotationZ, UpdateSourceTrigger=LostFocus}" />
                </UniformGrid>
                <TextBlock Text="Scale" Foreground="{DynamicResource TextSecondaryBrush}" />
                <UniformGrid Columns="3" Margin="0,3,0,12">
                    <TextBox Text="{Binding ScaleX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding ScaleY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding ScaleZ, UpdateSourceTrigger=LostFocus}" />
                </UniformGrid>
                <Separator Margin="0,2,0,8" />
                <TextBlock Text="Components" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Components}" SelectedValuePath="ComponentId" SelectedValue="{Binding SelectedComponentId, Mode=TwoWay}"
                         DisplayMemberPath="Kind" Height="82" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Add Model" Command="{Binding AddModelCommand}" Padding="8,3" Margin="0,0,5,0" />
                    <Button Content="Add Collider" Command="{Binding AddColliderCommand}" Padding="8,3" Margin="0,0,5,0" />
                    <Button Content="Add Rigidbody" Command="{Binding AddRigidbodyCommand}" Padding="8,3" Margin="0,0,5,0" />
                    <Button Content="Remove Component" Command="{Binding RemoveComponentCommand}" Padding="8,3" />
                </WrapPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedComponent.Kind}" Value="Model"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Model / Rendering" FontWeight="SemiBold" Margin="0,3,0,5" />
                    <TextBlock Text="Package-relative GLB" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBox Text="{Binding ModelPath, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7" />
                    <TextBlock Text="Intrinsic scale" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBox Text="{Binding ModelScale, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7" />
                    <TextBlock Text="Up axis" Foreground="{DynamicResource TextSecondaryBrush}" /><ComboBox ItemsSource="{Binding UpAxes}" SelectedItem="{Binding ModelUpAxis}" Margin="0,3,0,8" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedComponent.Kind}" Value="Collider"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Collider" FontWeight="SemiBold" Margin="0,3,0,5" />
                    <TextBlock Text="Shape" Foreground="{DynamicResource TextSecondaryBrush}" /><ComboBox ItemsSource="{Binding ColliderKinds}" SelectedItem="{Binding ColliderKind}" Margin="0,3,0,6" />
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ColliderKind}" Value="Sphere"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ColliderKind}" Value="Box"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ColliderKind}" Value="Capsule"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Center (X, Y, Z)" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <UniformGrid Columns="3" Margin="0,3,0,7"><TextBox Text="{Binding ColliderCenterX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" /><TextBox Text="{Binding ColliderCenterY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" /><TextBox Text="{Binding ColliderCenterZ, UpdateSourceTrigger=LostFocus}" /></UniformGrid>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ColliderKind}" Value="Sphere"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ColliderKind}" Value="Capsule"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Radius" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBox Text="{Binding ColliderRadius, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ColliderKind}" Value="Box"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Size (X, Y, Z)" Foreground="{DynamicResource TextSecondaryBrush}" /><UniformGrid Columns="3" Margin="0,3,0,7"><TextBox Text="{Binding ColliderSizeX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" /><TextBox Text="{Binding ColliderSizeY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" /><TextBox Text="{Binding ColliderSizeZ, UpdateSourceTrigger=LostFocus}" /></UniformGrid>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ColliderKind}" Value="Capsule"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Height" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBox Text="{Binding ColliderHeight, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7" /><TextBlock Text="Axis" Foreground="{DynamicResource TextSecondaryBrush}" /><ComboBox ItemsSource="{Binding CapsuleAxes}" SelectedItem="{Binding ColliderAxis}" Margin="0,3,0,7" />
                    </StackPanel>
                    <TextBlock Text="Source frame" Foreground="{DynamicResource TextSecondaryBrush}" /><ComboBox ItemsSource="{Binding ColliderSourceFrames}" SelectedItem="{Binding ColliderSourceFrame}" Margin="0,3,0,6" />
                    <CheckBox Content="Is trigger" IsChecked="{Binding ColliderIsTrigger}" Margin="0,2,0,8" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedComponent.Kind}" Value="Rigidbody"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Rigidbody" FontWeight="SemiBold" Margin="0,3,0,5" />
                    <TextBlock Text="Mode" Foreground="{DynamicResource TextSecondaryBrush}" /><ComboBox ItemsSource="{Binding RigidbodyModes}" SelectedItem="{Binding RigidbodyMode}" Margin="0,3,0,6" />
                    <TextBlock Text="Mass (kg)" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding RigidbodyMass, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,6">
                        <TextBox.Style><Style TargetType="TextBox"><Setter Property="IsEnabled" Value="False" /><Style.Triggers><DataTrigger Binding="{Binding RigidbodyMode}" Value="Dynamic"><Setter Property="IsEnabled" Value="True" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <CheckBox Content="Use gravity" IsChecked="{Binding RigidbodyUseGravity}" Margin="0,2,0,8" />
                </StackPanel>
                <Border Padding="8" CornerRadius="3" Background="{DynamicResource SelectionBrush}">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDiagnostic}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
