<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Oasis.Authoring.Core</AssemblyName>
    <RootNamespace>OasisEditor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <ProjectReference Include="../Oasis.Scripting/Oasis.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="FmlDecoder/Upstream/LICENSE;FmlDecoder/Upstream/upstream.json">
      <Link>ThirdParty/mfme-fml-decoder/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
