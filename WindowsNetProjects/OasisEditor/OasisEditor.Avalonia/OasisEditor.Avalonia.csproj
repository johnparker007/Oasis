    <Compile Include="../OasisEditor/InternalReelOffsetResolver.cs" Link="SharedRendering/InternalReelOffsetResolver.cs" />
    <Compile Include="../OasisEditor/PlatformReelDirectionResolver.cs" Link="SharedRendering/PlatformReelDirectionResolver.cs" />
    <Compile Include="../OasisEditor/FaceRuntimeStateResolver.cs" Link="SharedRendering/FaceRuntimeStateResolver.cs" />
    <Compile Include="../OasisEditor/ImageProcessingExecutionPolicy.cs" Link="SharedRendering/ImageProcessingExecutionPolicy.cs" />
    <Compile Include="../OasisEditor/FaceArtworkPerformanceTrace.cs" Link="SharedRendering/FaceArtworkPerformanceTrace.cs" />
    <Compile Include="../OasisEditor/BitmapPixelBuffer.cs" Link="SharedRendering/BitmapPixelBuffer.cs" />
    <Compile Include="../OasisEditor/PanelElementValidation.cs" Link="SharedRendering/PanelElementValidation.cs" />
    <Compile Include="../OasisEditor/InputMapDiagnostics.cs" Link="SharedAuthoring/InputMapDiagnostics.cs" />
