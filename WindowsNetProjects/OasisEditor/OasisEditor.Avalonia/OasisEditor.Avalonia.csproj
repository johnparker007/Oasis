    <Compile Include="../OasisEditor/Rendering/LampElementRenderer.cs" Link="SharedRendering/LampElementRenderer.cs" />
    <Compile Include="../OasisEditor/Rendering/ReelElementRenderer.cs" Link="SharedRendering/ReelElementRenderer.cs" />
