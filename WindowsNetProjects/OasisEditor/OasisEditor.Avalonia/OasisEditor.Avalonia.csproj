    <Compile Include="../OasisEditor/Rendering/SkiaPanelImageLoader.cs" Link="SharedRendering/SkiaPanelImageLoader.cs" />
    <Compile Include="../OasisEditor/Rendering/SkiaColorParser.cs" Link="SharedRendering/SkiaColorParser.cs" />
    <Compile Include="../OasisEditor/Rendering/MfmeTypefaceResolver.cs" Link="SharedRendering/MfmeTypefaceResolver.cs" />
    <Compile Include="../OasisEditor/Rendering/RuntimeTextLayout.cs" Link="SharedRendering/RuntimeTextLayout.cs" />
