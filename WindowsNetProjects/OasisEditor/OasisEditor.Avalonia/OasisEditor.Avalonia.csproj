<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Oasis.Authoring.Core/Oasis.Authoring.Core.csproj" />
    <ProjectReference Include="../Oasis.Rendering3D/Oasis.Rendering3D.csproj" />
    <ProjectReference Include="../Oasis.Authoring.ThreeD/Oasis.Authoring.ThreeD.csproj" />
    <ProjectReference Include="../Oasis.Authoring.Assets/Oasis.Authoring.Assets.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="../Oasis.Scripting/Oasis.Scripting.csproj" />
    <ProjectReference Include="../Oasis.RuntimeBuild/Oasis.RuntimeBuild.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.12" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.12" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../OasisEditor/Emulation/Fabric/**/*.cs" Link="SharedEmulation/Fabric/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../OasisEditor/Emulation/EmulationBackendAbstractions.cs" Link="SharedEmulation/EmulationBackendAbstractions.cs" />
    <Compile Include="../OasisEditor/Emulation/EmulationAudio.cs" Link="SharedEmulation/EmulationAudio.cs" />
    <Compile Include="../OasisEditor/Emulation/NAudioEmulationAudioSink.cs" Link="SharedEmulation/NAudioEmulationAudioSink.cs" />
    <Compile Include="../OasisEditor/Emulation/PcmFrameRingBuffer.cs" Link="SharedEmulation/PcmFrameRingBuffer.cs" />
    <Compile Include="../OasisEditor/Emulation/PcmRingWaveProvider.cs" Link="SharedEmulation/PcmRingWaveProvider.cs" />
    <Content Include="../OasisEditor/MfmeFonts/*.ttf">
      <Link>MfmeFonts/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../Assets/SegmentDisplays/*.json">
      <Link>Assets/SegmentDisplays/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../OasisEditor/MfmeFonts/*.ttf">
      <Link>MfmeFonts/%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <Compile Include="../OasisEditor/Rendering/IPanel2DRenderer.cs" Link="SharedRendering/IPanel2DRenderer.cs" />
    <Compile Include="../OasisEditor/Rendering/IPanelElementRenderer.cs" Link="SharedRendering/IPanelElementRenderer.cs" />
