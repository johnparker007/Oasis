// Initial single-ball Pool runtime proving case.
state collected = false;

on machine.started() {
    collected = false;
    oasis.set_active(oasis:ball01, true);
    oasis.teleport(oasis:ball01, anchor:rackBall01);
    oasis.set_velocity(oasis:ball01, vec3(0, 0, 0));
    oasis.set_angular_velocity(oasis:ball01, vec3(0, 0, 0));
}

on input.pressed(input:rerack) {
    collected = false;
    oasis.set_active(oasis:ball01, true);
    oasis.teleport(oasis:ball01, anchor:rackBall01);
    oasis.set_velocity(oasis:ball01, vec3(0, 0, 0));
    oasis.set_angular_velocity(oasis:ball01, vec3(0, 0, 0));
}

on input.pressed(input:newGame) {
    collected = false;
    oasis.set_active(oasis:ball01, true);
    oasis.teleport(oasis:ball01, anchor:rackBall01);
    oasis.set_velocity(oasis:ball01, vec3(0, 0, 0));
    oasis.set_angular_velocity(oasis:ball01, vec3(0, 0, 0));
}

on trigger.entered(pocket, ball) {
    if pocket == trigger:Pocket_XNeg_Middle or pocket == trigger:Pocket_XNeg_YNeg
        or pocket == trigger:Pocket_XNeg_YPos or pocket == trigger:Pocket_XPos_Middle
        or pocket == trigger:Pocket_XPos_YNeg or pocket == trigger:Pocket_XPos_YPos {
        if ball == oasis:ball01 and not collected {
            oasis.teleport(oasis:ball01, anchor:traySlot01);
            oasis.set_velocity(oasis:ball01, vec3(0, 0, 0));
            oasis.set_angular_velocity(oasis:ball01, vec3(0, 0, 0));
            collected = true;
        }
    }
}
